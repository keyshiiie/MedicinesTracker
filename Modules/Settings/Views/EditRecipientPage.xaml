<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Settings.Views.EditRecipientPage"
             xmlns:viewModels="clr-namespace:MedicinesTracker.Modules.Settings.ViewModels"
             x:DataType="viewModels:EditRecipientVM"
             Title="Получатель">
    <Grid RowDefinitions="*,Auto,Auto">
        <VerticalStackLayout Spacing="5">
            <Label Text="Имя получателя" 
                   Style="{StaticResource FieldDescriptionStyle}"/>
            <Border>
                <Entry Text="{Binding Recipient.Name}"
                       Style="{StaticResource EditFieldStyle}"
                       Placeholder="Введите имя получателя"/>
            </Border>
        </VerticalStackLayout>
        <Button Command="{Binding SaveRecipientCommand}" 
                Text="Сохранить"
                HorizontalOptions="Fill" 
                Grid.Row="2"
                Style="{StaticResource SaveMedicineButtonStyle}"/>
        <Button Style="{StaticResource DeleteButtonStyle}"
                Command="{Binding DeleteRecipientCommand}" 
                Grid.Row="1" 
                Margin="0,10"
                IsVisible="{Binding IsEditingExisting}"/>
    </Grid>
</ContentPage>