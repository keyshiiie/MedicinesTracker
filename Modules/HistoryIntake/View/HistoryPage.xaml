<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.HistoryIntake.View.HistoryPage"
             xmlns:viewModels="clr-namespace:MedicinesTracker.Modules.HistoryIntake.ViewModels"
             xmlns:dto="clr-namespace:MedicinesTracker.Dto"
             x:DataType="viewModels:HistoryPageVM"
             Title="История">

    <Grid>
        <!-- Индикатор загрузки поверх всего -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HeightRequest="50"
                           WidthRequest="50"
                           Color="{StaticResource Primary}"/>

        <!-- Основной контент с RefreshView -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <!-- Блок фильтров -->
                    <Border Style="{StaticResource MedicineCardBorderStyle}">
                        <VerticalStackLayout Spacing="10">

                            <!-- Фильтр по получателю -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Фильтр по получателю:"
                                       Style="{StaticResource FieldTitleStyle}"/>

                                <Picker Title="Выберите получателя"
                                        ItemsSource="{Binding Recipients}"
                                        SelectedItem="{Binding SelectedRecipient, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding Name}"
                                        Style="{StaticResource PrimaryPickerStyle}"/>
                            </VerticalStackLayout>

                            <!-- Разделитель -->
                            <BoxView HeightRequest="1"/>

                            <!-- Фильтр по дате -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Фильтр по дате:"
                                       Style="{StaticResource FieldTitleStyle}"/>

                                <!-- Выбор периода -->
                                <HorizontalStackLayout Spacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="С даты:" Style="{StaticResource CardDescriptionStyle}" FontSize="12"/>
                                        <DatePicker Date="{Binding StartDate, Mode=TwoWay}"
                                                    Format="yyyy-MM-dd"
                                                    Style="{StaticResource PrimaryDatePickerStyle}"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="По дату:" Style="{StaticResource CardDescriptionStyle}" FontSize="12"/>
                                        <DatePicker Date="{Binding EndDate, Mode=TwoWay}"
                                                    Format="yyyy-MM-dd"
                                                    Style="{StaticResource PrimaryDatePickerStyle}"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <!-- Кнопка применения фильтра по дате -->
                                <Button Text="Применить фильтр по дате"
                                        Command="{Binding ApplyDateFilterCommand}"
                                        Style="{StaticResource DefaultButtonStyle}"/>
                            </VerticalStackLayout>

                            <!-- Кнопки сброса фильтров -->
                            <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsFiltered}">
                                <Button Text="Сбросить все фильтры"
                                        Command="{Binding ClearFilterCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"/>

                                <Button Text="Сбросить дату"
                                        Command="{Binding ClearDateFilterCommand}"
                                        IsVisible="{Binding IsDateFilterActive}"
                                        Style="{StaticResource OutlineButtonStyle}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Список истории приема с группировкой по датам -->
                    <CollectionView ItemsSource="{Binding FilteredIntakes}"
                                    IsVisible="{Binding HasData}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:GroupedHistory">
                                <VerticalStackLayout Spacing="5">
                                    <!-- Заголовок с датой -->
                                    <Label Text="{Binding Date}"
                                           Style="{StaticResource FieldDescriptionStyle}"/>

                                    <!-- Лекарства за эту дату -->
                                    <CollectionView ItemsSource="{Binding Medicines}"
                                                    SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="dto:HistoryDto">
                                                <Border Style="{StaticResource MedicineCardBorderStyle}">
                                                    <VerticalStackLayout Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="{Binding RecipientName}"
                                                                   Style="{StaticResource CardDescriptionStyle}"/>
                                                            <Label Text="{Binding Status}"
                                                                   TextColor="{Binding StatusColor}"
                                                                   FontAttributes="Bold"
                                                                   Grid.Column="1"/>
                                                        </Grid>
                                                        <VerticalStackLayout Spacing="2">
                                                            <Label Text="{Binding NameMedicine}"
                                                                   Style="{StaticResource CardTitleStyle}"/>
                                                            <Label Text="{Binding Time, StringFormat='Необходимо принять в: {0}'}" 
                                                                   Style="{StaticResource CardDescriptionStyle}"/>
                                                            <Label Text="{Binding TakenTimeFormatted, StringFormat='Принято в: {0}'}"
                                                                   Style="{StaticResource CardDescriptionStyle}"/>
                                                        </VerticalStackLayout>
                                                        <HorizontalStackLayout Spacing="5">
                                                            <Label Text="{Binding ActualDosage}"
                                                                   Style="{StaticResource CardDescriptionStyle}"/>
                                                            <Label Text="{Binding UnitName}"
                                                                   Style="{StaticResource CardDescriptionStyle}"/>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Пустое состояние списка -->
                    <VerticalStackLayout 
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10"
                        IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="300">

                        <Label Text="История пуста"
                               Style="{StaticResource MainTitleStyle}"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{Binding EmptyMessage}"
                               Style="{StaticResource MainDescriptionStyle}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>