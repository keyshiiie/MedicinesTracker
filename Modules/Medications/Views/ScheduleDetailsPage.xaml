<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Medications.Views.ScheduleDetailsPage"
             xmlns:viewModels="clr-namespace:MedicinesTracker.Modules.Medications.ViewModels"
             x:DataType="viewModels:ScheduleDetailsVM"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:MedicinesTracker.Models"
             Title="Настройка расписания">

    <ScrollView>
        <VerticalStackLayout Spacing="15" VerticalOptions="Center">
            <!-- Заголовок -->
            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding Description}"
                       Style="{StaticResource CardDescriptionStyle}"/>
            </VerticalStackLayout>

            <!-- Частота приёма (для интервального режима) -->
            <VerticalStackLayout Spacing="10" 
                               IsVisible="{Binding IsIntervalMode}">
                <Label Text="Частота приёма:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                <Border Style="{StaticResource EditFielsBorderStyle}">
                    <Picker ItemsSource="{Binding RecurrencePatterns}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedRecurrencePattern, Mode=TwoWay}"
                            Style="{StaticResource PrimaryPickerStyle}"
                            Title="Выберите частоту приёма"/>
                </Border>
            </VerticalStackLayout>

            <!-- Дни недели (для режима по дням недели) -->
            <VerticalStackLayout Spacing="10" 
                               IsVisible="{Binding IsWeekDaysMode}">
                <Label Text="Дни недели:"
                       Style="{StaticResource CardDescriptionStyle}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeekDays}"
                                     Spacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WeekDayModel">
                            <Border Style="{StaticResource MedicineCardBorderStyle}" 
                                    Margin="0" 
                                    Padding="0">
                                <HorizontalStackLayout>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Color="{StaticResource Primary}"
                                              VerticalOptions="Center"/>
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource FieldTitleStyle}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding SelectedDaysText}"
                       Style="{StaticResource CardDescriptionStyle}"
                       FontAttributes="Italic"
                       IsVisible="{Binding HasSelectedDays}"/>
            </VerticalStackLayout>

            <!-- Даты начала и завершения (для повторяющихся) -->
            <VerticalStackLayout Spacing="10" 
                               IsVisible="{Binding IsRecurring}">
                <Label Text="Дата начала приёма:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                <Border Style="{StaticResource EditFielsBorderStyle}">
                    <DatePicker Style="{StaticResource PrimaryDatePickerStyle}"
                            Date="{Binding MedicineSchedule.DateStart, 
                            Converter={StaticResource StringToDateConverter}, 
                            Mode=TwoWay}"/>
                </Border>

                <Label Text="Дата завершения приёма:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                <Border Style="{StaticResource EditFielsBorderStyle}">
                    <DatePicker Style="{StaticResource PrimaryDatePickerStyle}" 
                            Date="{Binding MedicineSchedule.DateEnd,
                            Converter={StaticResource StringToDateConverter}, 
                            Mode=TwoWay}"/>
                </Border>
            </VerticalStackLayout>

            <!-- Дата приёма (для одноразовых) -->
            <VerticalStackLayout Spacing="10" 
                               IsVisible="{Binding IsOneTime}">
                <Label Text="Дата приёма:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                <Border Style="{StaticResource EditFielsBorderStyle}">
                    <DatePicker Style="{StaticResource PrimaryDatePickerStyle}"
                            MinimumDate="1900-01-01"
                            Date="{Binding MedicineSchedule.OneTimeDate,
                            Converter={StaticResource StringToDateConverter}, 
                            Mode=TwoWay}"/>
                </Border>
            </VerticalStackLayout>

            <!-- Выбор времени приема -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Время приёма:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                <!-- Список выбранных времен -->
                <CollectionView x:Name="TimeCollectionView"
                    ItemsSource="{Binding SelectedTimes}"
                    VerticalOptions="Start"
                    Margin="0,0,0,10">
                    <!-- Задаем ItemsLayout с отступами -->
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" 
                               ItemSpacing="5"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:TimeSpan}">
                            <Border Style="{StaticResource EditFielsBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto" 
                          Padding="5,0">
                                    <Label Text="{Binding ., Converter={StaticResource TimeSpanToStringConverter}}"
                               Grid.Column="0"
                               Style="{StaticResource FieldTitleStyle}"
                               VerticalOptions="Center"/>
                                    <Button Style="{StaticResource CloseButtonStyle}"
                                Grid.Column="1"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, 
                                Path=BindingContext.RemoveTimeCommand}"
                                CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Поле для добавления нового времени -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Добавить время приёма:"
               Style="{StaticResource CardDescriptionStyle}"/>
                    <HorizontalStackLayout Spacing="5">
                        <Border Style="{StaticResource EditFielsBorderStyle}">
                            <TimePicker Time="{Binding NewTime, Mode=TwoWay}" 
                            Style="{StaticResource TimePickerStyle}"/>
                        </Border>
                        <Button Style="{StaticResource DefaultButtonStyle}"
                    Text="+"
                    Command="{Binding AddTimeCommand}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Доза -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Доза:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                <Border Style="{StaticResource EditFielsBorderStyle}">
                    <Entry Text="{Binding MedicineSchedule.Dosage}"
                           Style="{StaticResource EditFieldStyle}" 
                           HorizontalOptions="Fill"
                           Placeholder="Введите количество лекарства"
                           Keyboard="Numeric"/>
                </Border>
            </VerticalStackLayout>

            <!-- Уведомления -->
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Уведомления:"
                       Style="{StaticResource CardDescriptionStyle}" 
                       VerticalOptions="Center"
                       Grid.Column="0"/>
                <Switch IsToggled="{Binding MedicineSchedule.ScheduleIsActive}" 
                        Grid.Column="1" 
                        HorizontalOptions="End"      
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Кнопки -->
            <Grid ColumnDefinitions="*,Auto" >
                <Button Text="Сохранить"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource SaveMedicineButtonStyle}"
                        Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>