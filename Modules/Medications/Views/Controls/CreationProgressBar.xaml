<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MedicinesTracker.Modules.Medications.Views.Controls.CreationProgressBar"
             x:Name="this"
             IsVisible="{Binding IsEditing, Source={x:Reference this}, Converter={StaticResource InvertedBoolConverter}}">

    <VerticalStackLayout Spacing="8">
        <!-- Прогресс-бар с ProgressBar -->
        <ProgressBar Progress="{Binding ProgressWidth, Source={x:Reference this}}"
                     HeightRequest="8"
                     Margin="20,0"
                     BackgroundColor="#E8E8E8"
                     ProgressColor="{StaticResource Primary}" />

        <Label Text="{Binding StepDescription, Source={x:Reference this}}"
               FontSize="12"
               TextColor="{StaticResource Gray}"
               HorizontalOptions="Center"
               Margin="0,4,0,0"/>
    </VerticalStackLayout>
</ContentView>