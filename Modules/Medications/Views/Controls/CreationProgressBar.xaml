<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Medications.Views.Controls.CreationProgressBar"
             x:Name="this">

    <VerticalStackLayout Spacing="5">
        <!-- Текущий шаг -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
            <Label Text="{Binding CurrentStep, Source={x:Reference this}}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>
            <Label Text="из" TextColor="Gray"/>
            <Label Text="{Binding TotalSteps, Source={x:Reference this}}"
                   FontAttributes="Bold"
                   TextColor="Gray"/>
        </HorizontalStackLayout>

        <!-- Прогресс-бар -->
        <Border StrokeThickness="0"
                BackgroundColor="#E0E0E0"
                Stroke="#E0E0E0"
                HeightRequest="8"
                Margin="20,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>

            <!-- Заполненная часть -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    HeightRequest="8"
                    HorizontalOptions="Start"
                    WidthRequest="{Binding ProgressWidth, Source={x:Reference this}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
            </Border>
        </Border>
    </VerticalStackLayout>
</ContentView>