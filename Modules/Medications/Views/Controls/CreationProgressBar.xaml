<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MedicinesTracker.Modules.Medications.Views.Controls.CreationProgressBar"
             x:Name="this"
             IsVisible="{Binding IsEditing, Source={x:Reference this}, Converter={StaticResource InvertedBoolConverter}}">

    <VerticalStackLayout Spacing="10">
        <!-- Прогресс-бар с ProgressBar -->
        <ProgressBar Progress="{Binding ProgressWidth, Source={x:Reference this}}"
                     HeightRequest="3"
                     Style="{StaticResource CreationProgressBarStyle}" />

        <Label Text="{Binding StepDescription, Source={x:Reference this}}"
               Style="{StaticResource CreationProgressLabelStyle}"/>
    </VerticalStackLayout>
</ContentView>