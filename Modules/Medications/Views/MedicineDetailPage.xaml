<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Medications.Views.MedicineDetailPage"
             x:DataType="viewModels:MedicineDetailVM"
             xmlns:models="clr-namespace:MedicinesTracker.Models.Dto"
             xmlns:viewModels="clr-namespace:MedicinesTracker.Modules.Medications.ViewModels"
             Title="Информация">
    <VerticalStackLayout>
        <Border Margin="0,0,0,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding OpenBaseInfoPageCommand, 
                    Source={RelativeSource AncestorType={x:Type viewModels:MedicineDetailVM}},
                    x:DataType=viewModels:MedicineDetailVM}"
                    CommandParameter="{Binding Medicine}" />   
            </Border.GestureRecognizers>
            <StackLayout Spacing="10" 
                         Padding="15">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource ImageBorderCardStyle}"
                            VerticalOptions="Center">
                        <Image Source="pill.png"
                               Style="{StaticResource MedicineIconStyle}"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <StackLayout Spacing="5">
                            <Label Text="{Binding MedicineName}"
                                   Style="{StaticResource FieldTitleStyle}"/>
                            <Label Text="Основная информация"
                                   Style="{StaticResource CardTitleStyle}"/>
                        </StackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Редактировать"
                                   Style="{StaticResource DetailLinkStyle}"/>
                            <Image Source="hint_swap_right.png"
                                   Style="{StaticResource DetailLinkIconStyle}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </StackLayout>
        </Border>
        <Border Margin="0,0,0,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding OpenStockPageCommand, 
                    Source={RelativeSource AncestorType={x:Type viewModels:MedicineDetailVM}},
                    x:DataType=viewModels:MedicineDetailVM}"
                    CommandParameter="{Binding Medicine}" />       
            </Border.GestureRecognizers>
            <StackLayout Spacing="10" 
                         Padding="15">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource ImageBorderCardStyle}"
                            VerticalOptions="Center">
                        <Image Source="medicine_box.png"
                               Style="{StaticResource MedicineIconStyle}"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <StackLayout Spacing="5">
                            <Label 
                                Text="Запас"
                                Style="{StaticResource CardTitleStyle}"/>
                        </StackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Редактировать"
                                   Style="{StaticResource DetailLinkStyle}"/>
                            <Image Source="hint_swap_right.png"
                                   Style="{StaticResource DetailLinkIconStyle}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </StackLayout>
        </Border>
        <Border Margin="0,0,0,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding OpenNotificationPageCommand, 
                    Source={RelativeSource AncestorType={x:Type viewModels:MedicineDetailVM}},
                    x:DataType=viewModels:MedicineDetailVM}"
                    CommandParameter="{Binding Medicine}"/>   
            </Border.GestureRecognizers>
            <StackLayout 
                Spacing="10"
                Padding="15">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource ImageBorderCardStyle}"
                            VerticalOptions="Center">
                        <Image Source="calendar.png"
                               Style="{StaticResource MedicineIconStyle}"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <StackLayout Spacing="5">
                            <Label 
                                Text="Расписание приёма"
                                Style="{StaticResource CardTitleStyle}"/>
                        </StackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Редактировать"
                                   Style="{StaticResource DetailLinkStyle}"/>
                            <Image Source="hint_swap_right.png"
                                   Style="{StaticResource DetailLinkIconStyle}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </StackLayout>
        </Border>
        <Button Style="{StaticResource DeleteButtonStyle}"
                Command="{Binding DeleteMedicineCommand}" 
                Grid.Row="1" 
                Margin="0,10"/>
    </VerticalStackLayout>
</ContentPage>