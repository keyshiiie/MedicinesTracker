<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Medications.Views.MedicineSchedulePage"
             xmlns:viewModels="clr-namespace:MedicinesTracker.Modules.Medications.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:MedicinesTracker.Models"
             x:DataType="viewModels:MedicineScheduleVM"
             Title="Расписание">

    <ScrollView>
        <Grid RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="15">
                <!-- Тип расписания -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Тип расписания:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                    <Border Style="{StaticResource EditFielsBorderStyle}">
                        <Picker ItemsSource="{Binding ScheduleTypes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedScheduleType, Mode=TwoWay}"
                                IsEnabled="{Binding CanEditSchedule}"
                                Style="{StaticResource PrimaryPickerStyle}"
                                Title="Выберите тип расписания"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Мод расписания - ТОЛЬКО для RECURRING -->
                <VerticalStackLayout Spacing="5" 
                                 IsVisible="{Binding UiState.IsRecurringSchedule}">
                    <Label Text="Способ задания расписания:"
                       Style="{StaticResource CardDescriptionStyle}"/>
                    <Border Style="{StaticResource EditFielsBorderStyle}">
                        <Picker ItemsSource="{Binding ScheduleModes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedScheduleMode, Mode=TwoWay}"
                                IsEnabled="{Binding CanEditSchedule}"
                                Style="{StaticResource PrimaryPickerStyle}"
                                Title="Выберите способ задания расписания"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Частота приёма - ТОЛЬКО для INTERVAL режима -->
                <VerticalStackLayout Spacing="5" 
                                 IsVisible="{Binding UiState.ShowFrequencyPicker}">
                    <Label Text="Частота приёма:"
                           Style="{StaticResource FieldTitleStyle}"/>
                    <Border Style="{StaticResource EditFielsBorderStyle}">
                        <Picker ItemsSource="{Binding RecurrencePatterns}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedRecurrencePattern, Mode=TwoWay}"
                                Style="{StaticResource PrimaryPickerStyle}"
                                Title="Выберите частоту приёма"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Выбор нескольких дней недели - ТОЛЬКО для WEEKDAYS режима -->
                <VerticalStackLayout Spacing="5" 
                                 IsVisible="{Binding UiState.ShowWeekDaysPicker}">
                    <Label Text="Дни недели:"
                       Style="{StaticResource FieldTitleStyle}"/>

                    <!-- Контейнер для дней недели -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeekDays}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:WeekDayModel">
                                <Border Style="{StaticResource MedicineCardBorderStyle}" Margin="0" Padding="15,0,0,0">
                                    <HorizontalStackLayout>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Color="{StaticResource Primary}"
                                                  VerticalOptions="Center"/>
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource FieldTitleStyle}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Показываем выбранные дни -->
                    <Label Text="{Binding SelectedDaysText}"
                           Style="{StaticResource CardDescriptionStyle}"
                           FontAttributes="Italic"
                           IsVisible="{Binding HasSelectedDays}"/>
                </VerticalStackLayout>

                <!-- Дата начала - ТОЛЬКО для повторяющихся-->
                <VerticalStackLayout Spacing="5" 
                                 IsVisible="{Binding UiState.ShowRecurringDateFields}">
                    <Label Text="Дата начала приёма:"
                       Style="{StaticResource FieldTitleStyle}"/>
                    <Border Style="{StaticResource EditFielsBorderStyle}">
                        <DatePicker Style="{StaticResource PrimaryDatePickerStyle}"
                                Date="{Binding MedicineSchedule.DateStart, 
                                Converter={StaticResource StringToDateConverter}, 
                                Mode=TwoWay}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Дата завершения - ТОЛЬКО для повторяющихся-->
                <VerticalStackLayout Spacing="5" 
                                     IsVisible="{Binding UiState.ShowRecurringDateFields}">
                    <Label Text="Дата завершения приёма:"
                           Style="{StaticResource FieldTitleStyle}"/>
                    <Border Style="{StaticResource EditFielsBorderStyle}">
                        <DatePicker Style="{StaticResource PrimaryDatePickerStyle}" 
                                Date="{Binding MedicineSchedule.DateEnd,
                                Converter={StaticResource StringToDateConverter}, 
                                Mode=TwoWay}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Дата приёма - ТОЛЬКО для одноразовых-->
                <VerticalStackLayout Spacing="5" 
                                 IsVisible="{Binding UiState.ShowOneTimeDateField}">
                    <Label Text="Дата приёма:"
                           Style="{StaticResource CardDescriptionStyle}"/>
                    <Border Style="{StaticResource EditFielsBorderStyle}">
                        <DatePicker Style="{StaticResource PrimaryDatePickerStyle}"
                                MinimumDate="1900-01-01"
                                Date="{Binding MedicineSchedule.OneTimeDate,
                                Converter={StaticResource StringToDateConverter}, 
                                Mode=TwoWay}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Выбор времени приема -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Время приёма:"
                           Style="{StaticResource CardDescriptionStyle}"/>
                    <!-- Список выбранных времен -->
                    <CollectionView x:Name="TimeCollectionView"
                                    ItemsSource="{Binding SelectedTimes}"
                                    VerticalOptions="Start"
                                    Margin="0,0,0,10">
                        <!-- Задаем ItemsLayout с отступами -->
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" 
                                               ItemSpacing="5"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type x:TimeSpan}">
                                <Border Style="{StaticResource EditFielsBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto" 
                                          Padding="5,0">
                                        <Label Text="{Binding ., Converter={StaticResource TimeSpanToStringConverter}}"
                                               Grid.Column="0"
                                               Style="{StaticResource FieldTitleStyle}"
                                               VerticalOptions="Center"/>
                                        <Button Style="{StaticResource CloseButtonStyle}"
                                                Grid.Column="1"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, 
                                                Path=BindingContext.RemoveTimeCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Поле для добавления нового времени -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Добавить время приёма:"
                               Style="{StaticResource CardDescriptionStyle}"/>
                        <HorizontalStackLayout Spacing="5">
                            <Border Style="{StaticResource EditFielsBorderStyle}">
                                <TimePicker Time="{Binding NewTime, Mode=TwoWay}" 
                                            Style="{StaticResource TimePickerStyle}"/>
                            </Border>
                            <Button Style="{StaticResource DefaultButtonStyle}"
                                    Text="+"
                                    Command="{Binding AddTimeCommand}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Общие поля (для всех типов) -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Доза:"
                           Style="{StaticResource CardDescriptionStyle}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource EditFielsBorderStyle}">
                            <Entry Text="{Binding MedicineSchedule.Dosage}"
                                   Style="{StaticResource EditFieldStyle}" 
                                   HorizontalOptions="Fill"
                                   Placeholder="Введите количетсво лекарства"/>
                        </Border>
                        <Label Text="{Binding MedicineSchedule.UnitName}"
                               Style="{StaticResource CardTitleStyle}"
                               Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*">
                    <Label 
                        Text="Уведомления:"
                        Style="{StaticResource CardDescriptionStyle}" 
                        VerticalOptions="Center"
                        HorizontalOptions="Start"/>
                    <Switch 
                        IsToggled="{Binding MedicineSchedule.ScheduleIsActive}" 
                        Grid.Column="1" 
                        HorizontalOptions="End"      
                        VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Row="1" 
                                   HorizontalOptions="End"
                                   Margin="0,20,0,0">
                <Button 
                    Command="{Binding SaveCommand}"
                    Text="{Binding SaveButtonState.Text}"
                    Style="{StaticResource SaveMedicineButtonStyle}"/>
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>