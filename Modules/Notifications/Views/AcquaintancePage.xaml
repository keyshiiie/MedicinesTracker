<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Notifications.Views.AcquaintancePage"
             xmlns:viewModels="clr-namespace:MedicinesTracker.Modules.Notifications.ViewModels"
             x:DataType="viewModels:AcquaintanceVM"
             Title="AcquaintancePage">

    <Grid RowDefinitions="*, Auto" Margin="10">
            <VerticalStackLayout Spacing="22"
                             VerticalOptions="Center">

                <Image Source="chat.png"
                       HeightRequest="150"
                       HorizontalOptions="Center"/>

                <Label Text="Для начала, как нам следует вас называть?"
                       Style="{StaticResource AcquaintanceTitleStyle}"
                       HorizontalOptions="Center" />

                <Entry Text="{Binding Recipient.Name}"
                   Style="{StaticResource EditFieldStyle}"
                   Placeholder="Введите ваше имя"/>


            </VerticalStackLayout>
        <Button Text="Продолжить"
                Padding="20,10"
                Style="{StaticResource DefaultButtonStyle}"
                Command="{Binding SaveAndContinueCommand}"
                Grid.Row="1"/>
    </Grid>
    
</ContentPage>