<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedicinesTracker.Modules.Notifications.Views.SimplePermissionPage"
             Title="SimplePermissionPage">
    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Разрешите уведомления"
               FontSize="24"
               FontAttributes="Bold" />

        <Label Text="Для напоминаний о приёме лекарств нужны уведомления."
               FontSize="16" />

        <Button Text="Разрешить"
                Clicked="OnAllowClicked"
                BackgroundColor="#2196F3"
                TextColor="White" />

        <Button Text="Позже"
                Clicked="OnLaterClicked" />

    </VerticalStackLayout>
</ContentPage>