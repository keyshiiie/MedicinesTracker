		</MauiXaml>
		<MauiXaml Update="Modules\Settings\Views\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Modules\Medications\Views\StockInfoPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Modules\Notifications\Views\TodayMedicinePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!-- Code-behind связи -->
	<ItemGroup>
		<Compile Update="Modules\Notifications\Views\AboutAppPage.xaml.cs">
			<DependentUpon>AboutAppPage.xaml</DependentUpon>
		</Compile>
		<Compile Update="Modules\Notifications\Views\TodayMedicinePage.xaml.cs">
			<DependentUpon>TodayMedicinePage.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>