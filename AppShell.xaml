<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MedicinesTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:medicationsViews="clr-namespace:MedicinesTracker.Modules.Medications.Views"
    xmlns:notificationsViews="clr-namespace:MedicinesTracker.Modules.Notifications.Views"
    xmlns:settingsViews="clr-namespace:MedicinesTracker.Modules.Settings.Views"
    xmlns:historyViews="clr-namespace:MedicinesTracker.Modules.HistoryIntake.View"
    Title="MedicinesTracker"
    Shell.FlyoutBehavior="Disabled">

    <Shell.ToolbarItems>
        <ToolbarItem IconImageSource="settings_light.png" Command="{Binding NavigateToSettingsCommand}" />
    </Shell.ToolbarItems>
    <TabBar>
        <Tab Title="Лекарства" Icon="medicine_box.png">
            <ShellContent ContentTemplate="{DataTemplate medicationsViews:MedicineListPage}" Route="medicines" />
        </Tab>
        <Tab Title="Сегодня" Icon="calendar.png">
            <ShellContent ContentTemplate="{DataTemplate notificationsViews:TodayMedicinePage}" Route="todayMedicines" />
        </Tab>
        <Tab Title="История" Icon="history.png">
            <ShellContent ContentTemplate="{DataTemplate historyViews:HistoryPage}" Route="history" />
        </Tab>
    </TabBar>
</Shell>
